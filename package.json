{
  "name": "bandulan-warung-gis",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Satellite-first Spatial Intelligence WebGIS for exploring local warungs and neighborhood geography in Kelurahan Bandulan, Malang.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare:data": "node scripts/prepare-geojson.mjs",
    "enrich:osm": "node scripts/enrich-osm.mjs"
  },
  "dependencies": {
    "@turf/area": "^7.2.0",
    "@turf/bbox": "^7.2.0",
    "@turf/boolean-intersects": "^7.2.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/buffer": "^7.2.0",
    "@turf/centroid": "^7.2.0",
    "@turf/distance": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/intersect": "^7.2.0",
    "@turf/length": "^7.2.0",
    "@turf/nearest-point": "^7.2.0",
    "@turf/nearest-point-on-line": "^7.2.0",
    "@turf/voronoi": "^7.2.0",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
